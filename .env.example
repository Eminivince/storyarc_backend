# Copy to `.env` and fill in. All keys below are referenced from `src/config/env.ts` (AppEnv)
# or are common for Prisma / tooling.

NODE_ENV=development
PORT=4000

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/talestead"
# Prisma migrations (e.g. Neon) — optional; omit if same as DATABASE_URL
DIRECT_URL=

# -----------------------------------------------------------------------------
# Redis (required)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
FRONTEND_APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Auth — email delivery
# -----------------------------------------------------------------------------
# live | capture (capture relaxes Resend requirements for local dev)
AUTH_EMAIL_DELIVERY_MODE=live
AUTH_TEST_SUPPORT_ENABLED=false
AUTH_SIGNUP_RATE_LIMIT_MAX=3
AUTH_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=1800
AUTH_LOGIN_FAILURE_THRESHOLD=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_LOGIN_FAILURE_BACKOFF_SECONDS=60,300,900,1800
AUTH_LOGIN_FAILURE_PENALTY_RESET_SECONDS=43200

# -----------------------------------------------------------------------------
# Auth — JWT & tokens (required)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
PASSWORD_RESET_CODE_SECRET=change-me-password-reset-code-secret
# Optional; omit to use PASSWORD_RESET_CODE_SECRET
# REGISTRATION_CODE_SECRET=
REGISTRATION_CODE_TTL_MINUTES=15
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_CODE_TTL_MINUTES=15
RESET_VERIFIED_TOKEN_TTL_MINUTES=15

# -----------------------------------------------------------------------------
# Resend (required when AUTH_EMAIL_DELIVERY_MODE=live)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=TaleStead <auth@yourdomain.com>

# -----------------------------------------------------------------------------
# Scheduled publish worker (defaults shown)
# -----------------------------------------------------------------------------
SCHEDULED_PUBLISH_INTERVAL_SECONDS=30
SCHEDULED_PUBLISH_BATCH_SIZE=10

# -----------------------------------------------------------------------------
# Paystack (optional)
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CURRENCY=USD
PAYSTACK_PLAN_SILVER_MONTHLY=
PAYSTACK_PLAN_SILVER_ANNUAL=
PAYSTACK_PLAN_ARCANE_MONTHLY=
PAYSTACK_PLAN_ARCANE_ANNUAL=

# -----------------------------------------------------------------------------
# Cryptomus (optional)
# -----------------------------------------------------------------------------
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_API_KEY=
CRYPTOMUS_CURRENCY=USD

# -----------------------------------------------------------------------------
# Flutterwave (optional) — code prefers FLUTTERWAVE_SECRET_KEY, else FLUTTERWAVE_CLIENT_SECRET
# -----------------------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_CURRENCY=NGN
FLUTTERWAVE_PLAN_SILVER_MONTHLY=
FLUTTERWAVE_PLAN_SILVER_ANNUAL=

# -----------------------------------------------------------------------------
# Polar (optional)
# -----------------------------------------------------------------------------
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_CURRENCY=USD
POLAR_COIN_PRODUCT_ID=
POLAR_PLAN_SILVER_MONTHLY=
POLAR_PLAN_SILVER_ANNUAL=
POLAR_PLAN_ARCANE_MONTHLY=
POLAR_PLAN_ARCANE_ANNUAL=

# -----------------------------------------------------------------------------
# Cloudinary (optional)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROFILE_IMAGE_FOLDER=

# -----------------------------------------------------------------------------
# OAuth — Google (optional)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# -----------------------------------------------------------------------------
# OAuth — mobile fallback when client omits mobile_redirect (optional)
# Example: exp://192.168.x.x:8081/--/auth/google/callback
# -----------------------------------------------------------------------------
MOBILE_OAUTH_CALLBACK_URL=

# -----------------------------------------------------------------------------
# Sign in with Apple — native iOS; value = iOS bundle ID (optional)
# -----------------------------------------------------------------------------
APPLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# OAuth — X / Twitter (optional)
# -----------------------------------------------------------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=

# -----------------------------------------------------------------------------
# OAuth — Facebook / Meta (optional)
# -----------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Mobile reader promos (optional JSON — see code comments in repo)
# -----------------------------------------------------------------------------
READER_DASHBOARD_PROMO_CAROUSEL_JSON=
READER_FLOATING_PROMO_JSON=

# -----------------------------------------------------------------------------
# Seed scripts only (not AppEnv) — prisma:seed:writer (see prisma/seed-writer-demo.ts)
# -----------------------------------------------------------------------------
WRITER_SEED_DISPLAY_NAME=
WRITER_SEED_EMAIL=
WRITER_SEED_LOCATION=
WRITER_SEED_PASSWORD=
WRITER_SEED_TAGLINE=
WRITER_SEED_WEBSITE=
WRITER_SEED_READER_EMAIL_DOMAIN=
WRITER_SEED_READER_LOCATION=
WRITER_SEED_READER_PASSWORD=
WRITER_SEED_READER_TAGLINE=
WRITER_SEED_STORY_COUNT=
WRITER_SEED_CHAPTERS_PER_STORY=
WRITER_SEED_STORY_CONCURRENCY=
WRITER_SEED_READER_COUNT=
WRITER_SEED_STORIES_PER_READER=
WRITER_SEED_COMMENTS_PER_READER=
WRITER_SEED_LISTS_PER_READER=
WRITER_SEED_READER_CONCURRENCY=

# -----------------------------------------------------------------------------
# One-off scripts (not AppEnv)
# -----------------------------------------------------------------------------
# scripts/send-creator-application-approved-email.ts
MANUAL_APPROVAL_EMAIL=
MANUAL_APPROVAL_NAME=
MANUAL_APPROVAL_GENRE=
MANUAL_APPROVAL_NOTES=
MANUAL_APPROVAL_STUDIO_URL=
MANUAL_APPROVAL_NO_REVENUE_SHARE=
MANUAL_APPROVAL_REVIEWED_AT=
# prisma/delete-all-books.ts — only with explicit opt-in in production
ALLOW_DELETE_ALL_BOOKS_IN_PRODUCTION=
