NODE_ENV=development
PORT=4000
AUTH_EMAIL_DELIVERY_MODE="live"
AUTH_TEST_SUPPORT_ENABLED=false
AUTH_SIGNUP_RATE_LIMIT_MAX=3
AUTH_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=1800
AUTH_LOGIN_FAILURE_THRESHOLD=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_LOGIN_FAILURE_BACKOFF_SECONDS="60,300,900,1800"
AUTH_LOGIN_FAILURE_PENALTY_RESET_SECONDS=43200
# Pooled connection (PgBouncer) for the app
DATABASE_URL=""
# Direct connection for migrations and Prisma CLI
DIRECT_URL=""
# Optional but recommended for production: shared sessions, caches, queues, distributed throttles.
# If Redis is unreachable, the API falls back to in-memory (per-process) storage and still starts.
# REDIS_URL="redis://localhost:6379"
REDIS_URL=""
FRONTEND_APP_URL="http://localhost:5173"
REGISTRATION_CODE_SECRET="change-me-registration-code-secret"
REGISTRATION_CODE_TTL_MINUTES=15
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
PASSWORD_RESET_CODE_SECRET="change-me-password-reset-code-secret"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_CODE_TTL_MINUTES=15
RESET_VERIFIED_TOKEN_TTL_MINUTES=15
RESEND_API_KEY="re_your_key"
RESEND_FROM_EMAIL="TaleStead <auth@yourdomain.com>"
PAYSTACK_SECRET_KEY="sk_test_your_key"
PAYSTACK_WEBHOOK_SECRET="sk_test_your_key"
PAYSTACK_CURRENCY="USD"
PAYSTACK_PLAN_SILVER_MONTHLY=""
PAYSTACK_PLAN_SILVER_ANNUAL=""
PAYSTACK_PLAN_ARCANE_MONTHLY=""
PAYSTACK_PLAN_ARCANE_ANNUAL=""
# Required for hosted Standard checkout (v3 API). Dashboard → API → Secret Key (FLWSECK_…).
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-…"
# Optional; v4 OAuth credentials are not used for Standard checkout in this app.
FLUTTERWAVE_CLIENT_ID="your_client_id"
FLUTTERWAVE_CLIENT_SECRET="your_client_secret"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxx"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxx"
FLUTTERWAVE_ENCRYPTION_KEY="your_encryption_key"
FLUTTERWAVE_WEBHOOK_SECRET="your_webhook_hash"
FLUTTERWAVE_CURRENCY="NGN"
FLUTTERWAVE_PLAN_SILVER_MONTHLY=""
FLUTTERWAVE_PLAN_SILVER_ANNUAL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
