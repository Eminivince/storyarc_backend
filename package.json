{
  "name": "backend",
  "version": "0.1.0",
  "description": "TaleStead backend base",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/main.js",
    "start:dev": "nodemon --watch src --ext ts,json --exec \"node --env-file=.env -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.ts\"",
    "start:debug": "node --inspect --env-file=.env -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.ts",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node --env-file=.env -r ts-node/register/transpile-only prisma/seed.ts",
    "prisma:seed:writer": "node --env-file=.env -r ts-node/register/transpile-only prisma/seed-writer-demo.ts",
    "prisma:seed:badges": "node --env-file=.env -r ts-node/register/transpile-only prisma/seed-badges.ts",
    "prisma:set-user-role": "node --env-file=.env -r ts-node/register/transpile-only prisma/set-user-role.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "nestjs",
    "prisma",
    "redis"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/compress": "^8.0.0",
    "@fastify/helmet": "^13.0.2",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.16",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.17",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.10.0",
    "node-html-parser": "^7.1.0",
    "otpauth": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.9.3",
    "rxjs": "7.8.1",
    "sanitize-html": "^2.17.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/sanitize-html": "^2.16.1",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
