model SupportTicket {
  id              String                @id @default(cuid())
  requesterUserId String
  assignedAdminId String?
  category        SupportTicketCategory
  priority        SupportTicketPriority @default(NORMAL)
  status          SupportTicketStatus   @default(OPEN)
  subject         String
  latestPreview   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  requester       User                  @relation("SupportRequester", fields: [requesterUserId], references: [id])
  assignedAdmin   User?                 @relation("SupportAssignee", fields: [assignedAdminId], references: [id])
  messages        SupportMessage[]

  @@index([status, updatedAt])
  @@index([requesterUserId, updatedAt])
  @@map("support_tickets")
}

model SupportMessage {
  id           String                   @id @default(cuid())
  ticketId     String
  senderUserId String?
  senderRole   SupportMessageSenderRole
  body         String
  createdAt    DateTime                 @default(now())
  ticket       SupportTicket            @relation(fields: [ticketId], references: [id])
  senderUser   User?                    @relation(fields: [senderUserId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model CreatorPayout {
  id                     String              @id @default(cuid())
  creatorUserId          String
  periodLabel            String
  amountCents            Int
  status                 CreatorPayoutStatus @default(PENDING)
  reviewNotes            String?
  reviewedByAdminUserId  String?
  releasedByAdminUserId  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  creator                User                @relation(fields: [creatorUserId], references: [id])

  @@index([status, updatedAt])
  @@index([creatorUserId, updatedAt])
  @@map("creator_payouts")
}

model AdminSetting {
  id          String           @id @default(cuid())
  key         String           @unique
  kind        AdminSettingKind @default(BOOLEAN)
  group       String
  title       String
  description String
  enabled     Boolean          @default(false)
  valueCents  Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([group])
  @@map("admin_settings")
}

model PromoSlide {
  id              String   @id @default(cuid())
  imageUrl        String
  title           String
  subtitle        String?
  badgeText       String?
  badgeType       String?
  cardCtaText     String?
  linkType        String
  linkTarget      String
  readChapterSlug String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("promo_slides")
}

model LimitedOffer {
  id            String   @id @default(cuid())
  storyId       String
  discountLabel String
  startsAt      DateTime
  endsAt        DateTime
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  story Story @relation(fields: [storyId], references: [id])

  @@index([isActive, startsAt, endsAt])
  @@map("limited_offers")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  targetType  String
  targetId    String?
  summary     String
  detail      String
  tone        String   @default("primary")
  icon        String   @default("bolt")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  adminUser   User?    @relation("AdminActor", fields: [adminUserId], references: [id])

  @@index([createdAt])
  @@index([adminUserId, createdAt])
  @@map("admin_audit_logs")
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("UserAdminRole")

  @@map("admin_roles")
}

model PendingAdminAction {
  id              String   @id @default(cuid())
  action          String
  targetType      String
  targetId        String
  payload         Json
  requestedBy     String
  status          String   @default("PENDING")
  reviewedBy      String?
  reviewNote      String?
  reviewedAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  requestedByUser User     @relation("PendingActionRequester", fields: [requestedBy], references: [id])
  reviewedByUser  User?    @relation("PendingActionReviewer", fields: [reviewedBy], references: [id])

  @@index([status, createdAt])
  @@index([requestedBy])
  @@map("pending_admin_actions")
}

model PaystackWebhookEvent {
  id               String   @id @default(cuid())
  paystackEventKey String   @unique
  eventType        String
  processedAt      DateTime
  createdAt        DateTime @default(now())

  @@map("paystack_webhook_events")
}

model FlutterwaveWebhookEvent {
  id          String   @id @default(cuid())
  eventKey    String   @unique
  eventType   String
  processedAt DateTime
  createdAt   DateTime @default(now())

  @@map("flutterwave_webhook_events")
}

model PolarWebhookEvent {
  id            String   @id @default(cuid())
  polarEventKey String   @unique
  eventType     String
  processedAt   DateTime
  createdAt     DateTime @default(now())

  @@map("polar_webhook_events")
}

// --- Phase 1: Security ---

model TotpCredential {
  id              String    @id @default(cuid())
  userId          String    @unique
  encryptedSecret String
  verified        Boolean   @default(false)
  enabledAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])

  @@map("totp_credentials")
}

// --- Phase 2: Monetization ---

model RefundRequest {
  id           String       @id @default(cuid())
  purchaseId   String
  userId       String
  reason       String
  status       RefundStatus @default(PENDING)
  amountCents  Int
  reviewedAt   DateTime?
  reviewedById String?
  reviewNotes  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  purchase     Purchase     @relation(fields: [purchaseId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("refund_requests")
}

// --- Phase 3: Engagement ---

model FcmToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  device    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("fcm_tokens")
}

// --- Phase 4: Creator Tools ---

model TaxForm {
  id          String    @id @default(cuid())
  userId      String
  formType    String
  formData    Json
  status      String    @default("PENDING")
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("tax_forms")
}

// --- Phase 5: Discovery ---

model ReviewVote {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  helpful   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  review    Review   @relation(fields: [reviewId], references: [id])

  @@unique([userId, reviewId])
  @@map("review_votes")
}

model BookmarkFolder {
  id        String     @id @default(cuid())
  userId    String
  name      String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  bookmarks Bookmark[]

  @@index([userId, sortOrder])
  @@map("bookmark_folders")
}

// --- Phase 6: Admin ---

model HelpCenterCategory {
  id          String              @id @default(cuid())
  title       String
  description String
  icon        String
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  articles    HelpCenterArticle[]

  @@map("help_center_categories")
}

model HelpCenterArticle {
  id         String             @id @default(cuid())
  categoryId String
  title      String
  excerpt    String
  body       String?
  tag        String?
  sortOrder  Int                @default(0)
  published  Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  category   HelpCenterCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId, sortOrder])
  @@map("help_center_articles")
}

// --- Phase 7: Retention Engine ---

model BadgeDefinition {
  id               String      @id @default(cuid())
  key              String      @unique
  title            String
  description      String
  category         String
  iconUrl          String      @default("")
  rarity           BadgeRarity @default(COMMON)
  requirementType  String
  requirementValue Int
  rewardPoints     Int         @default(0)
  sortOrder        Int         @default(0)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  userBadges         UserBadge[]
  readingChallenges  ReadingChallenge[]

  @@index([category, sortOrder])
  @@map("badge_definitions")
}

model UserBadge {
  id                String          @id @default(cuid())
  userId            String
  badgeDefinitionId String
  earnedAt          DateTime        @default(now())
  featured          Boolean         @default(false)
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id])
  badgeDefinition   BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id])

  @@unique([userId, badgeDefinitionId])
  @@index([userId, earnedAt])
  @@map("user_badges")
}

model RetentionEvent {
  id             String    @id @default(cuid())
  userId         String
  eventType      String
  channelType    String
  relatedStoryId String?
  metadata       Json?
  clickedAt      DateTime?
  sentAt         DateTime  @default(now())
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id])

  @@index([userId, sentAt])
  @@index([eventType, sentAt])
  @@map("retention_events")
}

model DailyRewardOutcome {
  id          String   @id @default(cuid())
  userId      String
  label       String
  basePoints  Int
  finalPoints Int
  wheelIndex  Int
  spunAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, spunAt])
  @@map("daily_reward_outcomes")
}

model DailyMissionBoard {
  id                  String            @id @default(cuid())
  userId              String
  cycleKey            String
  missionDefinitionId String
  slotIndex           Int
  createdAt           DateTime          @default(now())
  user                User              @relation(fields: [userId], references: [id])
  missionDefinition   MissionDefinition @relation(fields: [missionDefinitionId], references: [id])

  @@unique([userId, cycleKey, slotIndex])
  @@unique([userId, cycleKey, missionDefinitionId])
  @@index([userId, cycleKey])
  @@map("daily_mission_boards")
}

model CreatorScorecard {
  id                String    @id @default(cuid())
  userId            String
  weekStart         DateTime
  weekEnd           DateTime
  totalViews        Int       @default(0)
  totalReaders      Int       @default(0)
  newFollowers      Int       @default(0)
  chaptersPublished Int       @default(0)
  avgRetention      Float     @default(0)
  avgRating         Float     @default(0)
  totalComments     Int       @default(0)
  revenueEarned     Int       @default(0)
  emailSentAt       DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id])

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
  @@map("creator_scorecards")
}

// ─── Paragraph & Chapter Reactions ───────────────────────────────────

enum ReactionType {
  SHOCKED
  SAD
  LAUGHING
  HEART
  FIRE
  SCARED
}

model ParagraphReaction {
  id                 String           @id @default(cuid())
  userId             String
  publishedChapterId String
  paragraphIndex     Int
  reactionType       ReactionType
  createdAt          DateTime         @default(now())
  user               User             @relation(fields: [userId], references: [id])
  publishedChapter   PublishedChapter @relation(fields: [publishedChapterId], references: [id])

  @@unique([userId, publishedChapterId, paragraphIndex])
  @@index([publishedChapterId, paragraphIndex])
  @@map("paragraph_reactions")
}

model ChapterReaction {
  id                 String           @id @default(cuid())
  userId             String
  publishedChapterId String
  reactionType       ReactionType
  createdAt          DateTime         @default(now())
  user               User             @relation(fields: [userId], references: [id])
  publishedChapter   PublishedChapter @relation(fields: [publishedChapterId], references: [id])

  @@unique([userId, publishedChapterId])
  @@index([publishedChapterId, reactionType])
  @@map("chapter_reactions")
}

// ─── Reading Challenges / Seasonal Events ────────────────────────────

enum ChallengeType {
  SEASONAL
  WEEKLY
  SPECIAL
}

enum ChallengeMetric {
  CHAPTERS_READ
  READING_TIME_MINUTES
  STORIES_COMPLETED
  REVIEWS_WRITTEN
  COMMENTS_WRITTEN
  DAYS_STREAK
  BOOKS_STARTED
}

model ReadingChallenge {
  id            String                  @id @default(cuid())
  title         String
  description   String
  type          ChallengeType
  targetValue   Int
  targetMetric  ChallengeMetric
  rewardPoints  Int
  rewardBadgeId String?
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  rewardBadge   BadgeDefinition?        @relation(fields: [rewardBadgeId], references: [id])
  userProgress  UserChallengeProgress[]

  @@index([isActive, startsAt, endsAt])
  @@map("reading_challenges")
}

model UserChallengeProgress {
  id           String           @id @default(cuid())
  userId       String
  challengeId  String
  currentValue Int              @default(0)
  completedAt  DateTime?
  claimedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id])
  challenge    ReadingChallenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
  @@map("user_challenge_progress")
}

// ─── Point Shop ──────────────────────────────────────────────────────

enum ShopItemCategory {
  AVATAR_FRAME
  PROFILE_BADGE
  THEME
  READING_EFFECT
  TITLE
}

enum ShopItemDuration {
  PERMANENT
  TIMED
  SINGLE_USE
}

model PointShopItem {
  id           String                  @id @default(cuid())
  key          String                  @unique
  title        String
  description  String
  category     ShopItemCategory
  iconUrl      String?
  cost         Int
  durationType ShopItemDuration
  durationDays Int?
  maxPurchases Int?
  isActive     Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  purchases    UserPointShopPurchase[]

  @@index([isActive, category, sortOrder])
  @@map("point_shop_items")
}

model UserPointShopPurchase {
  id          String        @id @default(cuid())
  userId      String
  itemId      String
  purchasedAt DateTime      @default(now())
  expiresAt   DateTime?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id])
  item        PointShopItem @relation(fields: [itemId], references: [id])

  @@index([userId, isActive])
  @@index([expiresAt, isActive])
  @@map("user_point_shop_purchases")
}

// ─── Activity Feed ───────────────────────────────────────────────────

enum ActivityEventType {
  STARTED_STORY
  FINISHED_STORY
  REVIEWED_STORY
  ADDED_TO_LIST
  REACHED_MILESTONE
  EARNED_BADGE
}

model ActivityFeedEvent {
  id        String            @id @default(cuid())
  userId    String
  eventType ActivityEventType
  metadata  Json?
  storyId   String?
  chapterId String?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id])
  story     Story?            @relation(fields: [storyId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("activity_feed_events")
}

// ── Churn Prediction ──────────────────────────────────────────────

enum InterventionType {
  WELCOME_BACK_MODAL
  RE_ENGAGEMENT_EMAIL
  STREAK_SAVE_PUSH
  PERSONALIZED_RECOMMENDATION
  WIN_BACK_OFFER
}

enum ChurnRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  CHURNED
}

model RetentionIntervention {
  id               String           @id @default(cuid())
  userId           String
  interventionType InterventionType
  riskLevel        ChurnRiskLevel
  riskScore        Float
  sentAt           DateTime         @default(now())
  channel          String
  metadata         Json?
  clickedAt        DateTime?
  convertedAt      DateTime?
  createdAt        DateTime         @default(now())
  user             User             @relation(fields: [userId], references: [id])

  @@index([userId, sentAt])
  @@index([riskLevel, sentAt])
  @@map("retention_interventions")
}
