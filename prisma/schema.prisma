generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  READER
  CREATOR
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum StoryStatus {
  DRAFT
  PUBLISHED
  HIATUS
  COMPLETED
}

enum ChapterStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum CreatorApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ContractExclusivity {
  EXCLUSIVE
  NON_EXCLUSIVE
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PurchaseKind {
  COINS
  SUBSCRIPTION
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  CANCELED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  CRYPTOMUS
  FLUTTERWAVE
  POLAR
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIALING
}

enum WalletLedgerEntryType {
  CREDIT
  DEBIT
}

enum WalletLedgerReason {
  COIN_PURCHASE
  SUBSCRIPTION_GRANT
  CHAPTER_UNLOCK
  AD_UNLOCK
  GIFT_SENT
  ADMIN_ADJUSTMENT
  REFUND
}

enum ChapterEntitlementSource {
  COIN_UNLOCK
  AD_UNLOCK
}

enum GiftTransactionStatus {
  COMPLETED
  FAILED
}

enum RewardLedgerEntryType {
  CREDIT
  DEBIT
}

enum RewardLedgerReason {
  DAILY_CHECK_IN
  DAILY_WHEEL_SPIN
  MISSION_CLAIM
  REFERRAL_SHARE
  REFERRAL_COMPLETION
  LEADERBOARD_REWARD
  ADMIN_ADJUSTMENT
  READING_TIME
  BADGE_EARNED
  STREAK_SHIELD_PURCHASE
  CHALLENGE_CLAIM
  SHOP_PURCHASE
}

enum MissionGroup {
  READER
  AUTHOR
}

enum MissionMetricType {
  DAILY_CHECK_IN
  READ_CHAPTERS
  BOOKMARK_CHAPTERS
  SHARE_REFERRAL
  WRITE_WORDS
  COMPLETE_PROFILE
  REVIEW_STORY
  READING_TIME_MINUTES
  FOLLOW_STORIES
  FOLLOW_AUTHORS
}

enum MissionRecurrence {
  DAILY
  ONE_TIME
}

enum ReferralEventStatus {
  SHARED
  SIGNED_UP
  COMPLETED
}

enum ReferralPayoutStatus {
  PENDING
  APPROVED
  RELEASED
  REJECTED
}

enum LeaderboardPeriod {
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum NotificationType {
  REWARD
  MISSION
  REFERRAL
  COMMUNITY
  SYSTEM
  SECURITY
}

enum FollowTargetType {
  AUTHOR
  STORY
}

enum CommunityPostType {
  ANNOUNCEMENT
  POLL
}

enum CommunityPostStatus {
  LIVE
  ARCHIVED
}

enum UserActivityEventType {
  READ_CHAPTER
  BOOKMARK_CHAPTER
  DAILY_CHECK_IN
  SHARE_REFERRAL
  WRITE_WORDS
  COMPLETE_PROFILE
  READING_TIME
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum ReportTargetType {
  CHAPTER
  STORY
  COMMENT
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  TAKEDOWN
  DISMISSED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum ReadingListVisibility {
  PRIVATE
  PUBLIC
}

enum StoryRankingKind {
  TRENDING
  POPULAR
  TOP_RATED
  RISING
}

enum SupportTicketCategory {
  ACCOUNT
  BILLING
  CONTENT
  CREATOR
  TECHNICAL
  GENERAL
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportMessageSenderRole {
  USER
  ADMIN
  SYSTEM
}

enum CreatorPayoutStatus {
  PENDING
  IN_REVIEW
  RELEASED
  REJECTED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum AdminBookVisibilityState {
  PENDING_APPROVAL
  LIVE
  HIDDEN
}

enum AdminBookReleaseMode {
  PREMIUM_WINDOW
  MANUAL
}

enum AdminSettingKind {
  BOOLEAN
  CURRENCY_CENTS
  PERCENTAGE
}

enum AuthIdentityProvider {
  GOOGLE
  APPLE
  TWITTER
  FACEBOOK
}

model User {
  id                          String                          @id @default(cuid())
  email                       String?                         @unique
  isGuest                     Boolean                         @default(false)
  role                        UserRole                        @default(READER)
  status                      UserStatus                      @default(ACTIVE)
  emailVerifiedAt             DateTime?
  tosAcceptedAt               DateTime?
  tosVersion                  String?
  birthYear                   Int?
  ageVerifiedAt               DateTime?
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  profile                     Profile?
  credential                  Credential?
  totpCredential              TotpCredential?
  sessions                    Session[]
  passwordResetTokens         PasswordResetToken[]
  creatorApplication          CreatorApplication?             @relation("CreatorApplicant")
  reviewedCreatorApplications CreatorApplication[]            @relation("CreatorReviewer")
  authoredStories             Story[]                         @relation("StoryAuthor")
  authIdentities              AuthIdentity[]
  storyRatings                StoryRating[]
  reviews                     Review[]                        @relation("StoryReviewer")
  readingProgress             ReadingProgress[]
  bookmarks                   Bookmark[]
  readingLists                ReadingList[]
  wallet                      Wallet?
  purchases                   Purchase[]
  subscriptions               Subscription[]
  walletLedgerEntries         WalletLedgerEntry[]
  chapterEntitlements         ChapterEntitlement[]
  adUnlockRecords             AdUnlockRecord[]
  sentGiftTransactions        GiftTransaction[]               @relation("GiftSender")
  receivedGiftTransactions    GiftTransaction[]               @relation("GiftRecipient")
  rewardWallet                RewardWallet?
  rewardLedgerEntries         RewardLedgerEntry[]
  dailyCheckIns               DailyCheckIn[]
  missionStates               UserMissionState[]
  referralCode                ReferralCode?
  sentReferralEvents          ReferralEvent[]                 @relation("ReferralInviter")
  receivedReferralEvents      ReferralEvent[]                 @relation("ReferralInvitee")
  leaderboardEntries          LeaderboardEntry[]
  communityPosts              CommunityPost[]                 @relation("CommunityCreator")
  pollVotes                   PollVote[]
  appNotifications            AppNotification[]
  notificationPreference      NotificationPreference?
  activityEvents              UserActivityEvent[]
  submittedReports            ContentReport[]                 @relation("ReportReporter")
  assignedReports             ContentReport[]                 @relation("ReportAssignee")
  supportTickets              SupportTicket[]                 @relation("SupportRequester")
  assignedSupportTickets      SupportTicket[]                 @relation("SupportAssignee")
  supportMessages             SupportMessage[]
  adminAuditLogs              AdminAuditLog[]                 @relation("AdminActor")
  creatorPayouts              CreatorPayout[]
  reviewedBookControls        StoryAdminControl[]             @relation("BookControlReviewer")
  updatedBookControls         StoryAdminControl[]             @relation("BookControlUpdater")
  chapterOverrideUpdates      PublishedChapterAdminOverride[] @relation("ChapterOverrideUpdater")
  contractTemplatesCreated    ContractTemplate[]              @relation("ContractTemplateCreator")
  contractTemplatesUpdated    ContractTemplate[]              @relation("ContractTemplateUpdater")
  contractsAsParty            Contract[]                      @relation("ContractParty")
  contractsCreated            Contract[]                      @relation("ContractCreator")
  contractsUpdated            Contract[]                      @relation("ContractUpdater")
  follows                     Follow[]                        @relation("FollowerUser")
  authorFollowers             Follow[]                        @relation("FollowedAuthor")
  comments                    Comment[]                       @relation("CommentAuthor")
  moderatedComments           Comment[]                       @relation("CommentModerator")
  moderatedReviews            Review[]                        @relation("ReviewModerator")
  chapterReadEvents           ChapterReadEvent[]
  refundRequests              RefundRequest[]
  fcmTokens                   FcmToken[]
  taxForms                    TaxForm[]
  reviewVotes                 ReviewVote[]
  bookmarkFolders             BookmarkFolder[]
  userBadges                  UserBadge[]
  retentionEvents             RetentionEvent[]
  dailyRewardOutcomes         DailyRewardOutcome[]
  dailyMissionBoards          DailyMissionBoard[]
  creatorScorecards           CreatorScorecard[]
  paragraphReactions          ParagraphReaction[]
  chapterReactions            ChapterReaction[]
  challengeProgress           UserChallengeProgress[]
  pointShopPurchases          UserPointShopPurchase[]
  activityFeedEvents          ActivityFeedEvent[]
  retentionInterventions      RetentionIntervention[]
  referralEarnings            ReferralEarning[]
  referralPayouts             ReferralPayout[]
  referralEarningBalanceCents Int                             @default(0)
  adminRoleId                 String?
  adminRole                   AdminRole?                      @relation("UserAdminRole", fields: [adminRoleId], references: [id])
  requestedAdminActions       PendingAdminAction[]            @relation("PendingActionRequester")
  reviewedAdminActions        PendingAdminAction[]            @relation("PendingActionReviewer")

  @@index([isGuest, createdAt])
  @@index([adminRoleId])
  @@map("users")
}

model AuthIdentity {
  id             String               @id @default(cuid())
  userId         String
  provider       AuthIdentityProvider
  providerUserId String
  providerEmail  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@index([userId, provider])
  @@map("auth_identities")
}

model CreatorApplication {
  id                    String                   @id @default(cuid())
  userId                String                   @unique
  fullName              String
  email                 String
  primaryGenre          String
  experience            String
  portfolioUrl          String?
  motivation            String
  wantsContract                   Boolean                  @default(false)
  requestedContractType           ContractExclusivity?
  /// When status is APPROVED: whether this creator may hold story contracts with revenue share (>0%). Null = legacy rows (treated as true).
  revenueShareContractApproved    Boolean?
  status                          CreatorApplicationStatus @default(DRAFT)
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewNotes           String?
  reviewedByUserId      String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  user                  User                     @relation("CreatorApplicant", fields: [userId], references: [id])
  reviewedByUser        User?                    @relation("CreatorReviewer", fields: [reviewedByUserId], references: [id])

  @@index([status, updatedAt])
  @@index([reviewedByUserId])
  @@map("creator_applications")
}

model Profile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  displayName           String
  avatarUrl             String?
  bio                   String?
  location              String?
  tagline               String?
  website               String?
  twitter               String?
  discord               String?
  displayLanguage       String?   @default("English (US)")
  contentFiltering      Boolean   @default(true)
  privateLibrary        Boolean   @default(true)
  allowMessages         Boolean   @default(false)
  showActivity          Boolean   @default(true)
  selectedGenres        String[]  @default([])
  readingStyle          String?
  readingTheme          String?   @default("Dark")
  onboardingCompletedAt DateTime?
  termsAcceptedVersion  String?
  termsAcceptedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model Credential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@map("credentials")
}

model Session {
  id                    String    @id @default(cuid())
  userId                String
  refreshTokenHash      String
  userAgent             String?
  ipAddress             String?
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  lastUsedAt            DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([refreshTokenExpiresAt])
  @@map("sessions")
}

model AdminSequence {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_sequences")
}

model ContractTemplate {
  id                   String              @id @default(cuid())
  templateName         String
  description          String?
  companyName          String
  body                 String
  exclusivity          ContractExclusivity
  geographicRights     String
  termMonths           Int
  revenueSharePercent  Int
  signingBonusCoins    Int
  advancePaymentCents  Int
  createdByAdminUserId String?
  updatedByAdminUserId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdByAdminUser   User?               @relation("ContractTemplateCreator", fields: [createdByAdminUserId], references: [id])
  updatedByAdminUser   User?               @relation("ContractTemplateUpdater", fields: [updatedByAdminUserId], references: [id])
  contracts            Contract[]

  @@index([templateName, updatedAt])
  @@map("contract_templates")
}

model Contract {
  id                   String              @id @default(cuid())
  displayId            String              @unique
  userId               String
  storyId              String
  templateId           String?
  partyRole            String
  status               ContractStatus      @default(DRAFT)
  contractType         ContractExclusivity
  templateName         String
  companyName          String
  body                 String
  geographicRights     String
  termMonths           Int
  revenueSharePercent  Int
  signingBonusCoins    Int
  advancePaymentCents  Int
  activatedAt          DateTime?
  endedAt              DateTime?
  createdByAdminUserId String?
  updatedByAdminUserId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation("ContractParty", fields: [userId], references: [id])
  story                Story               @relation("StoryContract", fields: [storyId], references: [id])
  template             ContractTemplate?   @relation(fields: [templateId], references: [id])
  createdByAdminUser   User?               @relation("ContractCreator", fields: [createdByAdminUserId], references: [id])
  updatedByAdminUser   User?               @relation("ContractUpdater", fields: [updatedByAdminUserId], references: [id])

  @@index([status, updatedAt])
  @@index([userId, updatedAt])
  @@index([storyId, updatedAt])
  @@map("contracts")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  email      String
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([email, createdAt])
  @@map("password_reset_tokens")
}

model Genre {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("genres")
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tags")
}

model Story {
  id                    String                  @id @default(cuid())
  slug                  String                  @unique
  title                 String
  shortSynopsis         String
  synopsis              String
  authorId              String?
  authorName            String
  status                StoryStatus             @default(PUBLISHED)
  isLive                Boolean                 @default(false)
  liveAt                DateTime?
  language              String                  @default("English")
  maturityRating        String                  @default("16+")
  targetAudience        String                  @default("Young Adult")
  featured              Boolean                 @default(false)
  editorPick            Boolean                 @default(false)
  editorPickedAt        DateTime?
  deletedAt             DateTime?
  genreSlugs            String[]                @default([])
  tagSlugs              String[]                @default([])
  totalReads            Int                     @default(0)
  averageRating         Float                   @default(0)
  reviewCount           Int                     @default(0)
  publishedAt           DateTime?
  latestChapterAt       DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  author                User?                   @relation("StoryAuthor", fields: [authorId], references: [id])
  assets                StoryAsset?
  volumes               StoryVolume[]
  arcs                  StoryArc[]
  chapters              Chapter[]
  publishedChapters     PublishedChapter[]
  readingProgress       ReadingProgress[]
  bookmarks             Bookmark[]
  readingListItems      ReadingListItem[]
  chapterEntitlements   ChapterEntitlement[]
  adUnlockRecords       AdUnlockRecord[]
  giftTransactions      GiftTransaction[]
  walletLedgerEntries   WalletLedgerEntry[]
  ratings               StoryRating[]
  communityPosts        CommunityPost[]
  contentReports        ContentReport[]
  adminControl          StoryAdminControl?
  contracts             Contract[]              @relation("StoryContract")
  followers             Follow[]
  comments              Comment[]
  reviews               Review[]
  rankingEntries        StoryRankingEntry[]
  chapterReadEvents     ChapterReadEvent[]
  analyticsDaily        StoryAnalyticsDaily[]
  chapterAnalyticsDaily ChapterAnalyticsDaily[]
  activityFeedEvents    ActivityFeedEvent[]
  limitedOffers         LimitedOffer[]

  @@index([authorId])
  @@index([authorId, status, deletedAt])
  @@index([featured, status])
  @@index([editorPick, status])
  @@index([genreSlugs], type: Gin)
  @@index([tagSlugs], type: Gin)
  @@map("stories")
}

model StoryAsset {
  id             String   @id @default(cuid())
  storyId        String   @unique
  coverImageUrl  String
  bannerImageUrl String?
  cardImageUrl   String?
  accentColor    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  story          Story    @relation(fields: [storyId], references: [id])

  @@map("story_assets")
}

model StoryVolume {
  id          String     @id @default(cuid())
  storyId     String
  number      Int
  title       String
  sortOrder   Int
  statusLabel String     @default("Planning")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  story       Story      @relation(fields: [storyId], references: [id])
  arcs        StoryArc[]
  chapters    Chapter[]

  @@unique([storyId, number])
  @@index([storyId, sortOrder])
  @@map("story_volumes")
}

model StoryArc {
  id          String      @id @default(cuid())
  storyId     String
  volumeId    String
  title       String
  sortOrder   Int
  statusLabel String      @default("Planning")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  story       Story       @relation(fields: [storyId], references: [id])
  volume      StoryVolume @relation(fields: [volumeId], references: [id])
  chapters    Chapter[]

  @@index([storyId, volumeId, sortOrder])
  @@map("story_arcs")
}

model Chapter {
  id               String            @id @default(cuid())
  storyId          String
  volumeId         String?
  arcId            String?
  slug             String
  title            String
  chapterNumber    Int
  status           ChapterStatus     @default(PUBLISHED)
  excerpt          String?
  wordCount        Int               @default(0)
  readingMinutes   Int               @default(0)
  bodyDraft        String            @default("")
  premiumEnabled   Boolean           @default(false)
  coinUnlockPrice  Int               @default(50)
  authorNote       String?
  contentWarnings  String[]          @default([])
  scheduledFor     DateTime?
  lastPublishedAt  DateTime?
  /// Writer studio: hidden from structure / lists until restored (reader-facing publish unchanged).
  studioBinnedAt   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  story            Story             @relation(fields: [storyId], references: [id])
  volume           StoryVolume?      @relation(fields: [volumeId], references: [id])
  arc              StoryArc?         @relation(fields: [arcId], references: [id])
  publishedChapter PublishedChapter?

  @@unique([storyId, slug])
  @@unique([storyId, chapterNumber])
  @@index([storyId, status, chapterNumber])
  @@index([storyId, studioBinnedAt])
  @@map("chapters")
}

model PublishedChapter {
  id                  String                         @id @default(cuid())
  storyId             String
  chapterId           String                         @unique
  slug                String
  title               String
  chapterNumber       Int
  bodyParagraphs      String[]                       @default([])
  premium             Boolean                        @default(false)
  coinUnlockPrice     Int                            @default(50)
  publishedAt         DateTime                       @default(now())
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  story               Story                          @relation(fields: [storyId], references: [id])
  chapter             Chapter                        @relation(fields: [chapterId], references: [id])
  readingProgress     ReadingProgress[]
  bookmarks           Bookmark[]
  chapterEntitlements ChapterEntitlement[]
  adUnlockRecords     AdUnlockRecord[]
  walletLedgerEntries WalletLedgerEntry[]
  contentReports      ContentReport[]
  adminOverride       PublishedChapterAdminOverride?
  comments            Comment[]
  chapterReadEvents    ChapterReadEvent[]
  analyticsDaily       ChapterAnalyticsDaily[]
  paragraphReactions   ParagraphReaction[]
  chapterReactions     ChapterReaction[]

  @@unique([storyId, slug])
  @@unique([storyId, chapterNumber])
  @@index([storyId, publishedAt])
  @@map("published_chapters")
}

model StoryAdminControl {
  id                        String                   @id @default(cuid())
  storyId                   String                   @unique
  visibilityState           AdminBookVisibilityState @default(PENDING_APPROVAL)
  globalCoinCap             Int                      @default(50)
  defaultPremiumWindowHours Int                      @default(-1)
  releaseMode               AdminBookReleaseMode     @default(PREMIUM_WINDOW)
  reviewNotes               String?
  reviewedByAdminUserId     String?
  reviewedAt                DateTime?
  lastUpdatedByAdminUserId  String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  story                     Story                    @relation(fields: [storyId], references: [id])
  reviewedByAdminUser       User?                    @relation("BookControlReviewer", fields: [reviewedByAdminUserId], references: [id])
  lastUpdatedByAdminUser    User?                    @relation("BookControlUpdater", fields: [lastUpdatedByAdminUserId], references: [id])

  @@index([visibilityState, updatedAt])
  @@index([reviewedByAdminUserId])
  @@index([lastUpdatedByAdminUserId])
  @@map("story_admin_controls")
}

model PublishedChapterAdminOverride {
  id                         String           @id @default(cuid())
  publishedChapterId         String           @unique
  overrideEnabled            Boolean          @default(false)
  lockedOverride             Boolean?
  coinPriceOverride          Int?
  premiumWindowHoursOverride Int?
  updatedByAdminUserId       String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  publishedChapter           PublishedChapter @relation(fields: [publishedChapterId], references: [id])
  updatedByAdminUser         User?            @relation("ChapterOverrideUpdater", fields: [updatedByAdminUserId], references: [id])

  @@index([updatedByAdminUserId])
  @@map("published_chapter_admin_overrides")
}

model BookPlatformPolicy {
  id                        String               @id @default(cuid())
  key                       String               @unique
  defaultReleaseMode        AdminBookReleaseMode @default(PREMIUM_WINDOW)
  defaultPremiumWindowHours Int                  @default(-1)
  defaultCoinCap            Int                  @default(50)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@map("book_platform_policies")
}

model ReadingProgress {
  id                 String           @id @default(cuid())
  userId             String
  storyId            String
  publishedChapterId String
  progressPercent    Int              @default(0)
  paragraphIndex     Int              @default(0)
  lastReadAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id])
  story              Story            @relation(fields: [storyId], references: [id])
  chapter            PublishedChapter @relation(fields: [publishedChapterId], references: [id])

  @@unique([userId, storyId])
  @@index([userId, lastReadAt])
  @@map("reading_progress")
}

model Bookmark {
  id                 String           @id @default(cuid())
  userId             String
  storyId            String
  publishedChapterId String
  folderId           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id])
  story              Story            @relation(fields: [storyId], references: [id])
  chapter            PublishedChapter @relation(fields: [publishedChapterId], references: [id])
  folder             BookmarkFolder?  @relation(fields: [folderId], references: [id])

  @@unique([userId, publishedChapterId])
  @@index([userId, createdAt])
  @@index([storyId, userId])
  @@map("bookmarks")
}

model ReadingList {
  id          String                @id @default(cuid())
  userId      String
  name        String
  description String?
  visibility  ReadingListVisibility @default(PRIVATE)
  shareSlug   String                @unique
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id])
  items       ReadingListItem[]

  @@index([userId, updatedAt])
  @@map("reading_lists")
}

model ReadingListItem {
  id            String      @id @default(cuid())
  readingListId String
  storyId       String
  addedAt       DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  readingList   ReadingList @relation(fields: [readingListId], references: [id])
